{
  "name": "clinicpad",
  "version": "0.1.0",
  "private": true,
  "description": "Prescription-first clinic operating system with bring-your-own-pad templates.",
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/patch-react-ping.mjs --check",
    "build": "next build --turbopack",
    "prebuild:web": "node scripts/patch-react-ping.mjs --check",
    "build:web": "next build --turbopack",
    "prebuild:desktop": "node scripts/patch-react-ping.mjs --check",
    "build:desktop": "node scripts/build-desktop.mjs",
    "start": "next start",
    "postinstall": "node scripts/patch-react-ping.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "cross-env RX_VISUAL=1 playwright test tests/e2e/rx-visual.spec.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local src/server/db/seed.ts",
    "db:seed:catalogue": "tsx --env-file=.env.local src/server/db/catalogue-seed.ts",
    "db:sweep-test-tenants": "tsx --env-file=.env.local src/server/db/sweep-test-tenants.ts",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:dev": "tauri dev",
    "tauri:debug-build": "tauri build -- --debug",
    "tauri:hard-clean-build": "cd src-tauri && cargo clean && tauri build"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^12.23.12",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.2",
    "lucide-react": "^0.542.0",
    "next": "15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "papaparse": "^5.5.3",
    "postgres": "^4.1.0",
    "react": "19.1.0",
    "react-day-picker": "^9.9.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.62.0",
    "react-to-print": "^3.1.1",
    "tailwind-merge": "^3.3.1",
    "uuidv7": "^1.2.1",
    "xlsx-republish": "^0.20.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
