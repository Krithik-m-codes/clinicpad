# ClinicPad environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# See docs/SETUP.md for details on each variable.

# ---------------------------------------------------------------------------
# App (available now)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (Phase 0)
# Local Docker defaults; use Supabase Mumbai for staging/production.
# DATABASE_URL uses the pooled connection (6543) for the app.
# DIRECT_URL uses the direct connection (5432) for migrations.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://clinicpad:clinicpad@localhost:5432/clinicpad
DIRECT_URL=postgresql://clinicpad:clinicpad@localhost:5432/clinicpad

# ---------------------------------------------------------------------------
# Auth (Phase 0) - Supabase Auth is the current leaning (ADR-0008)
# Generate secrets with docs/SETUP.md section 3.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SECRET=
ENCRYPTION_KEY=

# SMS/OTP provider (only needed if not using Supabase phone auth)
SMS_PROVIDER_KEY=

# ---------------------------------------------------------------------------
# Storage and document engine (Phase 2)
# ---------------------------------------------------------------------------
GOTENBERG_URL=http://localhost:3001
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Email
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# ---------------------------------------------------------------------------
# Payments (Phase 3 India, Phase 5 international)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Phase 3)
# ---------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Observability and jobs (Phase 0/3)
# ---------------------------------------------------------------------------
SENTRY_DSN=
CRON_SECRET=
LOG_LEVEL=info
