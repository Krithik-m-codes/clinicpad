{
  "productName": "Doctor Prescription App",
  "version": "1.0.1",
  "identifier": "com.shubpy.doctor-prescription-app",
  "build": {
    "frontendDist": "../src/.dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Doctor Prescription App",
        "width": 1366,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "minWidth": 800,
        "minHeight": 600,
        "maxWidth": 1920,
        "maxHeight": 1080,
        "x": 100,
        "y": 100,
        "center": true,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "focus": true,
        "visible": true,
        "acceptFirstMouse": false,
        "tabbingIdentifier": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "assets/banner.png"
      }
    }
  }
}
